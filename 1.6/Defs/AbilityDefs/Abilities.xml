<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <AbilityDef>
    <defName>DV_Exemplar_Firebolts</defName>
    <label>heatspikes</label>
    <description>Fire a burst of low-accuracy energy bolts.</description>
    <writeCombatLog>True</writeCombatLog>
    <aiCanUse>true</aiCanUse>
    <ai_SearchAOEForTargets>true</ai_SearchAOEForTargets>
    <jobDef>CastAbilityOnThing</jobDef>
    <targetRequired>true</targetRequired>
    <showPsycastEffects>True</showPsycastEffects>
    <cooldownTicksRange>500</cooldownTicksRange>    <!-- 1.5 to 3 seconds -->
    <verbProperties>
      <verbClass>Verb_AbilityShoot</verbClass>
      <defaultProjectile>DV_Bullet_Knyfebolt</defaultProjectile>
      <range>30.9</range>
      <soundCast>Shot_MiniFlameblaster</soundCast>
      <muzzleFlashScale>9</muzzleFlashScale>
      <ticksBetweenBurstShots>6</ticksBetweenBurstShots>
      <warmupTime>0</warmupTime>
      <burstShotCount>5</burstShotCount>
      <accuracyTouch>0.9</accuracyTouch>
      <accuracyShort>0.8</accuracyShort>
      <accuracyMedium>0.7</accuracyMedium>
      <accuracyLong>0.6</accuracyLong>
      <ai_IsWeapon>false</ai_IsWeapon>
      <targetParams>
        <canTargetLocations>false</canTargetLocations>
        <canTargetPawns>true</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityFleckOnTarget">
        <fleckDef>PsycastPsychicEffect</fleckDef>
      </li>
    </comps>
  </AbilityDef>

  <ThingDef ParentName="BaseBullet">
    <defName>DV_Bullet_Knyfebolt</defName>
    <label>knyfebolt</label>
    <graphicData>
      <texPath>Things/Projectiles/Bullet_Knyfearrow</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>MoteGlow</shaderType>
    </graphicData>
    <projectile>
      <damageDef>Burn</damageDef>
      <damageAmountBase>14</damageAmountBase>
      <speed>90</speed>
    </projectile>
  </ThingDef>

  <AbilityDef>
    <defName>DV_Exemplar_PsychicBlast</defName>
    <label>psychic blast</label>
    <description>There was a description here.</description>
    <iconPath>UI/Icons/Genes/Gene_Bloodfeeder</iconPath>
    <jobDef>CastAbilityOnThingWithoutWeapon</jobDef>
    <canUseAoeToGetTargets>False</canUseAoeToGetTargets>
    <ai_SearchAOEForTargets>true</ai_SearchAOEForTargets>
    <targetRequired>false</targetRequired>
    <showCastingProgressBar>true</showCastingProgressBar>
    <aiCanUse>True</aiCanUse>
    <cooldownTicksRange>250</cooldownTicksRange>
    <warmupMoteSocialSymbol>UI/Abilities/BerserkTrance</warmupMoteSocialSymbol>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupEffecter>DV_Exemplar_PsychicBlastCoreo</warmupEffecter>
      <warmupTime>3</warmupTime>
      <requireLineOfSight>false</requireLineOfSight>
      <range>3.9</range>
      <drawAimPie>false</drawAimPie>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
        <canTargetPawns>false</canTargetPawns>
      </targetParams>
      <soundCast>DV_BlastCast</soundCast>
    </verbProperties>
    <comps>
      <li Class="EBSGFramework.CompProperties_EBSGBurst">
        <explosion>
          <radius>3.9</radius>
          <damageDef>Stun</damageDef>
          <explosionSound>Explosion_Vaporize</explosionSound>
          <damageAmount>10</damageAmount>
        </explosion>
      </li>
      <li Class="CompProperties_AbilityFleckOnTarget">
        <fleckDef>PsycastPsychicEffect</fleckDef>
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef>
    <defName>DV_Exemplar_Dash</defName>
    <label>elven dash</label>
    <description>Jump to a distant location using special ultrafast mechanoid muscles.</description>
    <jobDef>CastAbilityOnThing</jobDef>
    <iconPath>UI/Abilities/FireBurst</iconPath>
    <cooldownTicksRange>120</cooldownTicksRange>
    <aiCanUse>true</aiCanUse>
    <ai_SearchAOEForTargets>true</ai_SearchAOEForTargets>
    <targetRequired>true</targetRequired>
    <hostile>false</hostile>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <verbProperties>
      <verbClass>LTS_StonebornSiteGeneration.Verb_CastAbilityDash</verbClass>
      <label>jump</label>
      <violent>false</violent>
      <forceNormalTimeSpeed>false</forceNormalTimeSpeed>
      <warmupTime>0.5</warmupTime>
      <minRange>5.9</minRange>
      <range>30.9</range>
      <requireLineOfSight>true</requireLineOfSight>
      <soundCast>Longjump_Jump</soundCast>
      <soundLanding>Longjump_Land</soundLanding>
      <flyWithCarriedThing>false</flyWithCarriedThing>
      <targetParams>
        <canTargetLocations>false</canTargetLocations>
        <canTargetPawns>true</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
      </targetParams>
    </verbProperties>
  </AbilityDef>

  <ThingDef ParentName="EtherealThingBase">
    <defName>LTS_SFE_DashPawnFlier</defName>
    <label>dash</label>
    <thingClass>PawnFlyer</thingClass>
    <useHitPoints>false</useHitPoints>
    <drawOffscreen>true</drawOffscreen>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Skyfaller</altitudeLayer>
    <drawerType>RealtimeOnly</drawerType>

    <pawnFlyer>
      <flightDurationMin>0</flightDurationMin>
      <flightSpeed>50</flightSpeed>
      <workerClass>PawnFlyerWorker</workerClass>
      <heightFactor>0</heightFactor>
      <progressCurve>

        <points>
          <li>(0, 0)</li>

          <li>(0.1, 0.02)</li>
          <li>(0.2, 0.08)</li>
          <li>(0.3, 0.18)</li>
          <li>(0.4, 0.32)</li>
          <li>(0.5, 0.5)</li>
          <li>(0.6, 0.68)</li>
          <li>(0.7, 0.82)</li>
          <li>(0.8, 0.92)</li>
          <li>(0.9, 0.98)</li>

          <li>(1, 1)</li>
        </points>
      </progressCurve>
    </pawnFlyer>
  </ThingDef>

  <AbilityDef>
    <defName>DV_Exemplar_SkipAway</defName>
    <label>skip away</label>
    <description>Emit a burst of burning fuel in all directions to form puddles of ignited liquid on the ground.</description>
    <jobDef>CastAbilityOnThingWithoutWeapon</jobDef>
    <iconPath>UI/Abilities/FireBurst</iconPath>
    <cooldownTicksRange>400</cooldownTicksRange>
    <aiCanUse>true</aiCanUse>
    <ai_SearchAOEForTargets>true</ai_SearchAOEForTargets>
    <targetRequired>false</targetRequired>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <showCastingProgressBar>true</showCastingProgressBar>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>0.25</warmupTime>
      <range>24.9</range>
      <targetParams>
        <canTargetSelf>False</canTargetSelf>
        <canTargetAnimals>True</canTargetAnimals>
        <canTargetItems>True</canTargetItems>
      </targetParams>
      <soundCast>DV_SkipCast</soundCast>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityTeleport">
        <compClass>CompAbilityEffect_Teleport</compClass>
        <destination>RandomInRange</destination>
        <randomRange>6.9~24.9</randomRange>
        <clamorType>Ability</clamorType>
        <clamorRadius>10</clamorRadius>
        <destClamorType>Ability</destClamorType>
        <destClamorRadius>10</destClamorRadius>
        <stunTicks>70~120</stunTicks>
        <goodwillImpact>-15</goodwillImpact>
        <applyGoodwillImpactToLodgers>False</applyGoodwillImpactToLodgers>
      </li>
      <li Class="CompProperties_AbilityFleckOnTarget">
        <fleckDef>PsycastPsychicEffect</fleckDef>
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef ParentName="LongJumpMech">
    <defName>DV_RocketBoots_Boost</defName>
    <label>rocket boost</label>
    <description>Jump to a distant location using short range rocket jumpboots.</description>
    <iconPath>UI/Abilities/RocketBoost</iconPath>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <cooldownTicksRange>25000</cooldownTicksRange>    <!-- 8h -->
    <charges>2</charges>
    <hostile>false</hostile>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <verbProperties>
      <range>14</range>
      <minRange>2</minRange>
      <warmupEffecter>JumpMechWarmupEffect</warmupEffecter>
      <requireLineOfSight>true</requireLineOfSight>
      <flightEffecterDef>JumpMechFlightEffect</flightEffecterDef>
      <flyWithCarriedThing>true</flyWithCarriedThing>
      <soundLanding>JumpMechLand</soundLanding>
      <soundCast Inherit="False" />
    </verbProperties>
    <jobDef>CastJump</jobDef>
  </AbilityDef>

  <AbilityDef>
    <defName>ShockFistAbility</defName>
    <label>shock discharge</label>
    <description>Punch the ground with the shock fist bionic and release a powerful EMP pulse in an area.</description>
    <iconPath>UI/Abilities/ShockDischarge</iconPath>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <cooldownTicksRange>12000</cooldownTicksRange>    <!--The cooldown of the ability -->
    <canUseAoeToGetTargets>true</canUseAoeToGetTargets>
    <jobDef>CastAbilityOnThingWithoutWeapon</jobDef>
    <ai_SearchAOEForTargets>true</ai_SearchAOEForTargets>
    <targetRequired>False</targetRequired>
    <aiCanUse>true</aiCanUse>
    <displayOrder>300</displayOrder>

    <verbProperties>
      <verbClass>Verb_CastAbilityTouch</verbClass>
      <hasStandardCommand>false</hasStandardCommand>
      <range>-1</range>
      <warmupTime>0</warmupTime>
      <soundCast>Shot_MiniFlameblaster</soundCast>
      <drawAimPie>false</drawAimPie>
      <requireLineOfSight>false</requireLineOfSight>
      <targetParams>
        <canTargetSelf>True</canTargetSelf>
      </targetParams>
    </verbProperties>

    <comps>
      <li Class="EBSGFramework.CompProperties_EBSGBurst">
        <explosion>
          <radius>5</radius>
          <damageDef>EMP</damageDef>
          <damageAmount>28</damageAmount>
        </explosion>
      </li>
      <li Class="CompProperties_AbilityEffecterOnTarget">
        <effecterDef>BlastEMPShockwave</effecterDef>
        <maintainForTicks>60</maintainForTicks>
        <scale>1</scale>
      </li>
    </comps>

  </AbilityDef>

  <AbilityDef>
    <defName>WristFlamerAbility</defName>
    <label>wrist flamer</label>
    <description>Spray a burst of flaming chemfuel that sets everything in range ablaze.</description>
    <iconPath>UI/Abilities/WristFlamer</iconPath>
    <aiCanUse>true</aiCanUse>
    <displayOrder>300</displayOrder>
    <warmupStartSound>FireSpew_Warmup</warmupStartSound>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <hasStandardCommand>true</hasStandardCommand>
      <warmupTime>0.2</warmupTime>
      <range>4.9</range>
      <soundCast>Shot_MiniFlameblaster</soundCast>
      <muzzleFlashScale>9</muzzleFlashScale>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityFireSpew">
        <range>4.9</range>
        <lineWidthEnd>4</lineWidthEnd>
        <filthDef>Filth_Fuel</filthDef>
        <damAmount>12</damAmount>
        <effecterDef>Fire_Spew</effecterDef>
        <canHitFilledCells>true</canHitFilledCells>
      </li>
      <li Class="EBSGFramework.CompProperties_AbilityReloadable">
        <maxCharges>1</maxCharges>
        <ammoDef>Chemfuel</ammoDef>
        <ammoPerCharge>15</ammoPerCharge>
        <reloadDuration>100</reloadDuration>
        <reloadSound>Standard_Reload</reloadSound>
        <noChargesRemaining>Flamer empty.</noChargesRemaining>
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef>
    <defName>ArmCannonAbility</defName>
    <label>arm slugger</label>
    <description>Fire a volley of projectiles at an enemy.</description>
    <iconPath>UI/Abilities/ArmSlugger</iconPath>
    <writeCombatLog>True</writeCombatLog>
    <showPsycastEffects>False</showPsycastEffects>
    <cooldownTicksRange>60</cooldownTicksRange>
    <displayOrder>200</displayOrder>
    <aiCanUse>true</aiCanUse>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <defaultProjectile>ArmCannonProjectile</defaultProjectile>
      <range>4.9</range>
      <soundCast>Shot_Shotgun</soundCast>
      <soundCastTail>GunTail_Medium</soundCastTail>
      <muzzleFlashScale>9</muzzleFlashScale>
      <warmupTime>0.4</warmupTime>
      <ai_IsWeapon>true</ai_IsWeapon>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityLaunchProjectile">
        <projectileDef>ArmCannonProjectile</projectileDef>
      </li>
      <li Class="EBSGFramework.CompProperties_AbilityReloadable">
        <maxCharges>3</maxCharges>
        <ammoDef>Steel</ammoDef>
        <ammoPerCharge>10</ammoPerCharge>
        <reloadDuration>60</reloadDuration>
        <reloadSound>Standard_Reload</reloadSound>
        <noChargesRemaining>Slugger empty.</noChargesRemaining>
      </li>
    </comps>
  </AbilityDef>

  <ThingDef ParentName="BaseBullet">
    <defName>ArmCannonProjectile</defName>
    <label>slugs</label>
    <graphicData>
      <texPath>Things/Projectiles/Bullet_Slugger</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>12</damageAmountBase>
      <stoppingPower>2.5</stoppingPower>
      <armorPenetrationBase>0.2</armorPenetrationBase>
      <speed>55</speed>
    </projectile>
  </ThingDef>

  <AbilityDef>
    <defName>TempBarrierAbility</defName>
    <label>barrier kit</label>
    <description>Launch a quick-deploy barrier at a location.</description>
    <iconPath>UI/Abilities/BarrierThrow</iconPath>
    <cooldownTicksRange>40</cooldownTicksRange>
    <displayOrder>200</displayOrder>
    <aiCanUse>false</aiCanUse>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>4.2</range>
      <warmupTime>1.5</warmupTime>
      <ai_AvoidFriendlyFireRadius>5</ai_AvoidFriendlyFireRadius>
      <soundCast>RocketswarmLauncher_Fire</soundCast>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityLaunchProjectile">
        <projectileDef>TempBarrierProjectile</projectileDef>
      </li>
      <li Class="EBSGFramework.CompProperties_AbilityReloadable">
        <maxCharges>3</maxCharges>
        <ammoDef>Steel</ammoDef>
        <ammoPerCharge>25</ammoPerCharge>
        <reloadDuration>60</reloadDuration>
        <reloadSound>Standard_Reload</reloadSound>
        <noChargesRemaining>Empty barrier kit.</noChargesRemaining>
      </li>
    </comps>
  </AbilityDef>

  <ThingDef ParentName="BaseBullet">
    <defName>TempBarrierProjectile</defName>
    <label>barrier kit</label>
    <thingClass>Projectile_SpawnsThing</thingClass>
    <graphicData>
      <drawSize>1.5</drawSize>
      <texPath>Things/Projectiles/Bullet_Barrier</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Blunt</damageDef>
      <damageAmountBase>2</damageAmountBase>
      <armorPenetrationBase>0</armorPenetrationBase>
      <spawnsThingDef>DV_TemporaryBarricade</spawnsThingDef>
      <tryAdjacentFreeSpaces>true</tryAdjacentFreeSpaces>
      <speed>42</speed>
    </projectile>
  </ThingDef>

  <AbilityDef>
    <defName>RocketFistAbility</defName>
    <label>rocket punch</label>
    <description>Launch your rocket fist at an enemy or location, which explodes in a small radius.</description>
    <iconPath>UI/Abilities/RocketPunch</iconPath>
    <cooldownTicksRange>60</cooldownTicksRange>
    <displayOrder>200</displayOrder>
    <aiCanUse>true</aiCanUse>

    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>12.2</range>
      <warmupTime>1.4</warmupTime>
      <ai_AvoidFriendlyFireRadius>5</ai_AvoidFriendlyFireRadius>
      <soundCast>RocketswarmLauncher_Fire</soundCast>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
      </targetParams>
    </verbProperties>

    <comps>
      <li Class="CompProperties_AbilityLaunchProjectile">
        <projectileDef>RocketFistProjectile</projectileDef>
      </li>
      <li Class="EBSGFramework.CompProperties_AbilityReloadable">
        <maxCharges>1</maxCharges>
        <ammoDef>Steel</ammoDef>
        <ammoPerCharge>20</ammoPerCharge>
        <reloadDuration>60</reloadDuration>
        <reloadSound>Standard_Reload</reloadSound>
        <noChargesRemaining>Missing rocket fist.</noChargesRemaining>
      </li>
    </comps>
  </AbilityDef>

  <ThingDef ParentName="BaseBullet">
    <defName>RocketFistProjectile</defName>
    <label>rocket fist</label>
    <thingClass>Projectile_Explosive</thingClass>
    <graphicData>
      <texPath>Things/Projectiles/Bullet_RocketFist</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Bomb</damageDef>
      <explosionRadius>1.4</explosionRadius>
      <speed>45</speed>
      <damageAmountBase>10</damageAmountBase>
      <arcHeightFactor>0.1</arcHeightFactor>
      <soundExplode>Explosion_Rocket</soundExplode>
    </projectile>
    <comps>
      <li Class="CompProperties_ProjectileEffecter">
        <effecterDef>Rocket_SmokeStream</effecterDef>
      </li>
    </comps>
  </ThingDef>

  <AbilityDef>
    <defName>DV_ImpFireSpew</defName>
    <label>fire spew</label>
    <description>Spit a stream of sticky, flammable bile from the mouth. The bile can ignite anything or anyone it hits, and also form flaming pools on the ground.\n\nThe bile is generated and stored by an organ in the neck, along with a separate pouch of hypergolic reactant for ignition.</description>
    <iconPath>UI/Abilities/FireSpew</iconPath>
    <cooldownTicksRange>300000</cooldownTicksRange>
    <aiCanUse>true</aiCanUse>
    <ai_IsIncendiary>true</ai_IsIncendiary>
    <sendMessageOnCooldownComplete>true</sendMessageOnCooldownComplete>
    <warmupStartSound>FireSpew_Warmup</warmupStartSound>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>7.9</range>
      <warmupTime>1</warmupTime>
      <soundCast>FireSpew_Resolve</soundCast>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityFireSpew">
        <range>7.9</range>
        <lineWidthEnd>3</lineWidthEnd>
        <filthDef>Filth_FlammableBile</filthDef>
        <effecterDef>Fire_Spew</effecterDef>
        <canHitFilledCells>true</canHitFilledCells>
      </li>
      <li MayRequire="Ludeon.RimWorld.Odyssey" Class="CompProperties_AbilityRequiresTrainable">
        <trainableDef>DV_ImpFireSpewDef</trainableDef>
        <aiCanCastWithoutTrainable>true</aiCanCastWithoutTrainable>
      </li>
    </comps>
  </AbilityDef>

  <TrainableDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>DV_ImpFireSpewDef</defName>
    <label>fire spew</label>
    <description>Command the animal to spit bellows of fire from its maw.</description>
    <listPriority>0</listPriority>
    <difficulty>200</difficulty>
    <steps>2</steps>
    <specialTrainable>true</specialTrainable>
    <enablesAbility>DV_ImpFireSpew</enablesAbility>
  </TrainableDef>

</Defs>
