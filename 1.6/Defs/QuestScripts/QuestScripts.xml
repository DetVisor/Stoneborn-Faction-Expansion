	<root Class="LTS_StonebornSiteGeneration.QuestNode_Mission_MiningQuota">
      <resourceDefs>
        <li>Steel</li>
        <li>Plasteel</li>
        <li>Gold</li>
		<li>Silver</li>
        <li>Uranium</li>
		<li MayRequire="det.epochspyrinth">DV_Pyrinth</li>
		<!--<li MayRequire="det.sbdelights">Uranium</li>-->
      </resourceDefs>
      <resourceRequirementsPerQuestPointsCurve>
        <points>
          <li>(0, 500)</li>
          <li>(10000, 5000)</li>
        </points>
      </resourceRequirementsPerQuestPointsCurve>
      <shuttleDef>LTS_DrillShuttle</shuttleDef>
	  <pocketMapSize>75</pocketMapSize>
	  <pocketMapGenerator>LTS_StonebornCave</pocketMapGenerator>
    </root>
	
  </QuestScriptDef>
  
</Defs>