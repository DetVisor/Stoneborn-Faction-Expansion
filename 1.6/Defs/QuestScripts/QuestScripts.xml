<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <QuestScriptDef>
    <defName>LTS_OpportunitySite_AncientStonebornRuin</defName>
    <rootSelectionWeight>1</rootSelectionWeight>
    <rootMinPoints>350</rootMinPoints>
    <autoAccept>true</autoAccept>
    <defaultChallengeRating>1</defaultChallengeRating>
    <isRootSpecial>true</isRootSpecial>
    <questNameRules>
      <rulesStrings>

        <!-- quest name -->
        <li>questName(p=3)->[complexAdj] stoneborn [complex]</li>
        <li>questName->stoneborn [complex]</li>

        <li>complexAdj->secret</li>
        <li>complexAdj->ancient</li>
        <li>complexAdj->old</li>
        <li>complexAdj->hidden</li>
        <li>complexAdj->dusty</li>
        <li>complexAdj->dangerous</li>
        <li>complexAdj->hidden</li>

        <li>complex->complex</li>
        <li>complex->lair</li>
        <li>complex->base</li>
        <li>complex->compound</li>
        <li>complex->crypt</li>

      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->You've [discoveryDesc] of an ancient stoneborn ruin nearby.\n\nYou can break in and loot the ruin for a chance to obtain rare stoneborn materials and technology.\n\nBe warned - these kinds of structures can contain a variety of threats, and your activity at the complex might draw unwanted attention.</li>

        <!-- Snippets -->
        <li>discoveryDesc(discovered==false)->learned</li>
        <li>discoveryDesc(discovered==true)->determined the location</li>

      </rulesStrings>
    </questDescriptionRules>
    <questDescriptionAndNameRules>
      <rulesStrings>
      </rulesStrings>
    </questDescriptionAndNameRules>
    <root Class="LTS_StonebornSiteGeneration.QuestNode_Root_Loot_AncientComplex_Stoneborn" />
  </QuestScriptDef>

  <QuestScriptDef>
    <defName>LTS_OpportunitySite_AncientStonebornVault</defName>
    <rootSelectionWeight>1</rootSelectionWeight>
    <rootMinPoints>350</rootMinPoints>
    <autoAccept>true</autoAccept>
    <defaultChallengeRating>1</defaultChallengeRating>
    <isRootSpecial>true</isRootSpecial>
    <questNameRules>
      <rulesStrings>

        <!-- quest name -->
        <li>questName(p=3)->[complexAdj] stoneborn [complex]</li>
        <li>questName->stoneborn [complex]</li>

        <li>complexAdj->secret</li>
        <li>complexAdj->ancient</li>
        <li>complexAdj->old</li>
        <li>complexAdj->hidden</li>
        <li>complexAdj->dusty</li>
        <li>complexAdj->dangerous</li>
        <li>complexAdj->hidden</li>

        <li>complex->bunker</li>
        <li>complex->lair</li>
        <li>complex->vault</li>
        <li>complex->dungeon</li>
        <li>complex->crypt</li>

      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->You've [discoveryDesc] of an ancient stoneborn vault nearby.\n\nYou can break in and loot the ruin for a chance to obtain rare stoneborn materials and technology.\n\nBe warned - these kinds of structures can contain a variety of threats, and your activity at the complex might draw unwanted attention.</li>

        <!-- Snippets -->
        <li>discoveryDesc(discovered==false)->discovered</li>
        <li>discoveryDesc(discovered==false)->learned</li>
        <li>discoveryDesc(discovered==false)->triangulated the location</li>
        <li>discoveryDesc(discovered==true)->determined the location</li>

      </rulesStrings>
    </questDescriptionRules>
    <questDescriptionAndNameRules>
      <rulesStrings>
      </rulesStrings>
    </questDescriptionAndNameRules>
    <root Class="LTS_StonebornSiteGeneration.QuestNode_Root_Loot_AncientVault_Stoneborn" />
  </QuestScriptDef>

  <QuestScriptDef>
    <defName>LTS_Mission_StonebornCave</defName>
    <rootSelectionWeight>1</rootSelectionWeight>
    <rootMinPoints>350</rootMinPoints>
    <expireDaysRange>10</expireDaysRange>
    <!--<affectedByPopulation>false</affectedByPopulation>-->
    <everAcceptableInSpace>false</everAcceptableInSpace>
    <!--<successHistoryEvent MayRequire="Ludeon.RimWorld.Ideology">Raided_BanditCamp</successHistoryEvent>
	<isRootSpecial>true</isRootSpecial>-->
    <questNameRules>
      <rulesStrings>
        <li>questName->[questNameInner]</li>
        <li>questName->[asker_nameDef]'s [questNameInner]</li>

        <li>questNameInner->[drill] [work]</li>

        <li>drill->drill</li>
        <li>drill->mine</li>
        <li>drill->cave</li>
		<li>drill->caveshuttle</li>

        <li>work->work</li>
        <li>work->job</li>
		<li>work->expedition</li>
		<li>work->prospecting</li>
		<li>work->quota</li>
      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->[asker_nameDef] is planning to set up an underground outpost, but requires more information on the mineral wealth of the cave [asker_pronoun]'s considering. [asker_pronoun] would like you to travel to the cave and gather:
\n  [resourceAmount]x [resourceDef_label] (worth [resourceTotalValue]).
\n[asker_pronoun] will send a caveshuttle to pick up your miners, bring them to the cave, and take them home afterward. [asker_pronoun] states that you're free to keep any excess [resourceDef_label] you gather, as well as any other resources you extract.</li>
	  </rulesStrings>
    </questDescriptionRules>
	
