<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef ParentName="BaseFilth">
        <defName>DV_Filth_MonsterMud</defName>
        <label>mud clay</label>
        <statBases>
            <Beauty>-30</Beauty>
            <Cleanliness>-5</Cleanliness>
        </statBases>
        <graphicData>
            <texPath>Things/Filth/PoolSoft</texPath>
            <color>(98, 67, 50)</color>
        </graphicData>
        <filth>
            <disappearsInDays>35~40</disappearsInDays>
            <rainWashes>true</rainWashes>
            <cleaningWorkToReduceThickness>70</cleaningWorkToReduceThickness>
            <canFilthAttach>true</canFilthAttach>
            <cleaningSound>Interact_CleanFilth_Fluid</cleaningSound>
        </filth>
    </ThingDef>

    <ThingDef ParentName="BaseFilth">
        <defName>DV_Filth_BrokenEquipment</defName>
        <label>broken equipment</label>
        <graphicData>
            <graphicClass>Graphic_Random</graphicClass>
            <texPath>Things/Filth/BrokenEquipment</texPath>
        </graphicData>
        <filth>
            <placementMask>
                <li>Terrain</li>
                <li>Unnatural</li>
            </placementMask>
            <ignoreFilthMultiplierStat>true</ignoreFilthMultiplierStat>
            <disappearsInDays>35~40</disappearsInDays>
            <cleaningWorkToReduceThickness>25</cleaningWorkToReduceThickness>
            <canFilthAttach>true</canFilthAttach>
            <cleaningSound>Interact_CleanFilth_Scattered</cleaningSound>
        </filth>
    </ThingDef>

    <ThingDef ParentName="BaseFilth">
        <defName>DV_Filth_OldAlcohol</defName>
        <label>old alcohol</label>
        <description>A puddle of old, flammable alcohol.</description>
        <useHitPoints>true</useHitPoints>
        <tickerType>Normal</tickerType>
        <statBases>
            <Beauty>-10</Beauty>
            <Cleanliness>-15</Cleanliness>
            <MaxHitPoints>150</MaxHitPoints>
            <Flammability>2.0</Flammability>
        </statBases>
        <graphicData>
            <texPath>Things/Filth/LiquidFuel</texPath>
            <color>(110, 89, 68)</color>
        </graphicData>
        <filth>
            <ignoreFilthMultiplierStat>true</ignoreFilthMultiplierStat>
            <disappearsInDays>80~90</disappearsInDays>
            <rainWashes>true</rainWashes>
            <cleaningWorkToReduceThickness>70</cleaningWorkToReduceThickness>
            <canFilthAttach>true</canFilthAttach>
            <maxThickness>1</maxThickness>
            <cleaningSound>Interact_CleanFilth_Fluid</cleaningSound>
        </filth>
    </ThingDef>

    <ThingDef ParentName="BaseFilth">
        <defName>DV_Filth_CavegunkGoop</defName>
        <label>cavegunk goop</label>
        <thingClass>LiquidFuel</thingClass>
        <useHitPoints>true</useHitPoints>
        <tickerType>Normal</tickerType>
        <statBases>
            <Beauty>-10</Beauty>
            <Cleanliness>-15</Cleanliness>
            <MaxHitPoints>150</MaxHitPoints>
            <Flammability>2.0</Flammability>
        </statBases>
        <graphicData>
            <texPath>Things/Filth/Goop</texPath>
        </graphicData>
        <filth>
            <ignoreFilthMultiplierStat>true</ignoreFilthMultiplierStat>
            <disappearsInDays>35~40</disappearsInDays>
            <rainWashes>true</rainWashes>
            <cleaningWorkToReduceThickness>70</cleaningWorkToReduceThickness>
            <canFilthAttach>true</canFilthAttach>
            <maxThickness>2</maxThickness>
            <cleaningSound>Interact_CleanFilth_Fluid</cleaningSound>
        </filth>
    </ThingDef>

    <ThingDef ParentName="BaseFilth">
        <defName>DV_Filth_MithriumBits</defName>
        <label>mithrium bits</label>
        <statBases>
            <Beauty>-5</Beauty>
            <Cleanliness>-5</Cleanliness>
        </statBases>
        <graphicData>
            <texPath>Things/Filth/MithriumFilth</texPath>
        </graphicData>
        <filth>
            <ignoreFilthMultiplierStat>true</ignoreFilthMultiplierStat>
            <disappearsInDays>45~50</disappearsInDays>
            <cleaningWorkToReduceThickness>35</cleaningWorkToReduceThickness>
            <cleaningSound>Interact_CleanFilth_Fluid</cleaningSound>
        </filth>
    </ThingDef>

</Defs>