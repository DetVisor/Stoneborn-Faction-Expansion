  <ThingDef ParentName="LTS_ApparelUnmakeableNecklaceBase">
    <defName>DV_Exemplar_AmuletOfIllyavrith</defName>
    <label>amulet of Illyavrith</label>
    <description>An ornate knyfevyn amulet emblazoned with the icon of their archotech god. It radiates sinister psychic energies.\n\nArtefacts such as these are found exclusively among the ranks of the ancient knyfevyn empire's elite exemplar.</description>
    <techLevel>Archotech</techLevel>
    <costList>
      <Plasteel>20</Plasteel>
	  <Gold>10</Gold>
    </costList>
    <graphicData>
      <texPath>Things/Item/Equipment/Loot/Exemplar/Exemplar_Amulet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <!--<tickerType>Normal</tickerType>-->
    <statBases>
	  <MarketValue>1200</MarketValue>
      <Flammability>0</Flammability>
	  <DeteriorationRate>0.1</DeteriorationRate>
	  <EquipDelay>5</EquipDelay>
    </statBases>
    <apparel>
      <abilities>
	    <!--DV_Exemplar_PsychicBlast-->
        <li>DV_Player_PsychicBlast</li>
      </abilities>
      <!--<scoreOffset>4</scoreOffset>-->
      <wornGraphicPath>Things/Item/Equipment/Loot/Exemplar/Exemplar_Amulet</wornGraphicPath>
      <useWornGraphicMask>false</useWornGraphicMask>
    </apparel>
    <allowedArchonexusCount>1</allowedArchonexusCount>
	<generateAllowChance>0</generateAllowChance>
	<tradeTags Inherit="False" />
	<equippedStatOffsets>
	  <PsychicSensitivity>2</PsychicSensitivity>
      <LTS_SFE_HungerRateFactor>0.5</LTS_SFE_HungerRateFactor>
    </equippedStatOffsets>
	<modExtensions>
      <li Class="VEF.Apparels.ApparelExtension">
        <traitsOnEquip><li>Cannibal</li></traitsOnEquip>
      </li>
    </modExtensions>
