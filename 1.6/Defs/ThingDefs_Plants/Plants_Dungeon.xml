    <ThingDef ParentName="PlantBase">
        <defName>DV_Plant_Cinderwort</defName>
        <label>sagewick</label>
        <description>A spicy tough herb. Sagewicks are a such a common-growing herb they're considered weeds in stoneborn farms, some say they grow so fast their stem can be heard hissing like a lit fuse, which is how they've earned their name.</description>
        <statBases>
            <MaxHitPoints>85</MaxHitPoints>
            <Nutrition>0.175</Nutrition>
        </statBases>
        <graphicData>
            <texPath>Things/Plant/Cinderwort</texPath>
            <graphicClass>Graphic_Random</graphicClass>
        </graphicData>
        <selectable>true</selectable>
        <pathCost>50</pathCost>
        <tickerType>Normal</tickerType>
        <ingestible />
        <plant>
            <fertilityMin>0</fertilityMin>
            <fertilitySensitivity>0</fertilitySensitivity>
            <harvestTag>Standard</harvestTag>
            <harvestedThingDef>DV_RawCinderwort</harvestedThingDef>
            <harvestYield>20</harvestYield>
            <topWindExposure>0</topWindExposure>
            <growDays>4</growDays>
            <cavePlantWeight>0</cavePlantWeight>
            <visualSizeRange>0.8~1.2</visualSizeRange>
            <purpose>Food</purpose>
            <humanFoodPlant>true</humanFoodPlant>
            <maxMeshCount>4</maxMeshCount>
            <growMinGlow>0</growMinGlow>
            <growOptimalGlow>0</growOptimalGlow>
            <diesToLight>false</diesToLight>
        </plant>
        <comps>
            <li Class="CompProperties_Glower">
                <glowRadius>3</glowRadius>
                <glowColor>(207,118,27,0)</glowColor>
            </li>
            <li Class="CompProperties_Effecter">
                <effecterDef>DV_SagewickSizzle</effecterDef>
            </li>
        </comps>
    </ThingDef>

    <ThingDef ParentName="PlantFoodRawBase">
        <defName>DV_RawCinderwort</defName>
        <label>raw sagewick</label>
        <description>Raw sagewick.</description>
        <graphicData>
            <texPath>Things/Item/Resource/Cinderwort</texPath>
            <graphicClass>Graphic_StackCount</graphicClass>
        </graphicData>
        <statBases>
            <MarketValue>1.2</MarketValue>
        </statBases>
        <ingestible>
            <foodType>VegetableOrFruit</foodType>
            <specialThoughtAsIngredient>DV_AteCinderwortIngredient</specialThoughtAsIngredient>
        </ingestible>
        <comps>
            <li Class="CompProperties_Rottable">
                <daysToRotStart>80</daysToRotStart>
                <rotDestroys>true</rotDestroys>
            </li>
        </comps>
    </ThingDef>

    <ThoughtDef>
        <defName>DV_AteCinderwortIngredient</defName>
        <durationDays>2</durationDays>
        <stackLimit>3</stackLimit>
        <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
        <stages>
            <li>
                <label>fired up</label>
                <description>I ate a meal with sagewick, spicy but delicious!</description>
                <baseMoodEffect>3</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

</Defs>