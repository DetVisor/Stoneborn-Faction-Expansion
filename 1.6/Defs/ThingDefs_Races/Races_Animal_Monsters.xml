<Defs>

  <ThingDef ParentName="BaseInsect">
    <defName>DV_Monster_CaveGunk</defName>
    <label>cavegunk</label>
    <description>A large, unicellular organism that thrives on scraps of organic materials found anywhere, from the bottom of a kitchen counter, to the forgotten halls of stoneborn vaults. Cavegunks are simple-minded and only exist to consume and replicate.</description>
    <statBases>
      <MoveSpeed>2.75</MoveSpeed>
      <ComfyTemperatureMin>-32</ComfyTemperatureMin>
      <MarketValue>200</MarketValue>
      <LeatherAmount>0</LeatherAmount>
      <ArmorRating_Blunt>0.60</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.10</ArmorRating_Sharp>
      <Wildness>0.2</Wildness>
    </statBases>
    <tools>
      <li>
        <label>slap</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>10</power>
        <cooldownTime>2.2</cooldownTime>
      </li>
    </tools>
    <race>
      <fleshType>DV_Fleshtype_MonsterGunk</fleshType>
      <body>DV_Gooplike</body>
      <baseHungerRate>0.40</baseHungerRate>
      <baseBodySize>1.12</baseBodySize>
      <baseHealthScale>1.2</baseHealthScale>
      <meatLabel>goop</meatLabel>
      <lifeExpectancy>500</lifeExpectancy>
      <needsRest>false</needsRest>
      <hasGenders>false</hasGenders>
      <foodType>None</foodType>
      <bloodDef>DV_Filth_CavegunkGoop</bloodDef>
      <trainability>None</trainability>
      <isImmuneToInfections>true</isImmuneToInfections>
      <lifeStageAges>
        <li>
          <def>EusocialInsectAdult</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_Cavegunk_Hit</soundWounded>
          <soundDeath>Pawn_Cavegunk_Splatter</soundDeath>
          <soundCall>Pawn_Cavegunk_Call</soundCall>
          <soundAngry>Pawn_Cavegunk_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
    </race>
    <comps>
      <li Class="CompProperties_Effecter">
        <effecterDef>DV_DrippingGunk</effecterDef>
      </li>
      <li Class="LTS_StonebornSiteGeneration.CompProperties_DeathEffects">
        <filthDef>DV_Filth_CavegunkGoop</filthDef>
        <filthLayersRange>0~2</filthLayersRange>
        <filthRadius>1</filthRadius>
        <vanish>True</vanish>
        <effecterDef>DV_Damage_SlimeVanish</effecterDef>
        <extraItemList>
          <li MayRequireAnyOf ="det.epochsgolems,det.epochspottery">
            <thingDef>DV_Clay</thingDef>
            <countRange>5~10</countRange>
          </li>
        </extraItemList>
      </li>
    </comps>
  </ThingDef>

