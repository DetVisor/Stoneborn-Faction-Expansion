  <ThingDef ParentName="BigBirdThingBase">
    <defName>DV_Monster_Razorbeak</defName>
    <label>razorbeak</label>
    <description>A large flightless bird with brightly-colored feathers. While it looks beautiful, its kick is vicious. It's known for being quick to aggression when harmed by violence or confronted by incompetent animal tamers.</description>
    <statBases>
      <MoveSpeed>8</MoveSpeed>
      <MarketValue>120</MarketValue>
      <ComfyTemperatureMin>-8</ComfyTemperatureMin>
      <ComfyTemperatureMax>50</ComfyTemperatureMax>
      <FilthRate>8</FilthRate>
      <Wildness>0.8</Wildness>
    </statBases>
    <race>
      <herdAnimal>false</herdAnimal>
      <baseBodySize>0.6</baseBodySize>
      <baseHealthScale>0.8</baseHealthScale>
      <baseHungerRate>0.50</baseHungerRate>
      <foodType>CarnivoreAnimal</foodType>
      <roamMtbDays>3</roamMtbDays>
      <lifeExpectancy>15</lifeExpectancy>
      <meatLabel>razorbeak meat</meatLabel>
      <manhunterOnTameFailChance>0.70</manhunterOnTameFailChance>
