<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="BuildingBase">
        <defName>DV_Monster_Gutterlatch</defName>
        <label>gutterlatch</label>
        <description>A peculiar land-dwelling mollusk that resides within dank, dark and abandoned places. Gutterlatches are considered pests, as they can reproduce fast and take over entire structures if left unchecked. When threatened by anything, they can spit out globs of toxic goo to draw predators away.n/n/Their meat is considered a delicacy in some places, and pairs well with fungus.</description>
        <thingClass>Building_TurretGun</thingClass>
        <drawerType>MapMeshAndRealTime</drawerType>
        <graphicData>
            <texPath>Things/Pawn/Animal/Gutterlatch/GutterlatchBottom</texPath>
            <graphicClass>Graphic_Random</graphicClass>
            <drawSize>(1.22,1.22)</drawSize>
            <drawOffset>(0,0,0.04)</drawOffset>
            <onGroundRandomRotateAngle>360</onGroundRandomRotateAngle>
            <damageData>
                <rect>(0.2,0.2,0.6,0.6)</rect>
            </damageData>
            <shadowData>
                <volume>(0.27,0.25,0.27)</volume>
                <offset>(0,0,0)</offset>
            </shadowData>
        </graphicData>
        <costList>
            <DV_Meat_Gutterlatch>120</DV_Meat_Gutterlatch>
        </costList>
        <drawHighlight>true</drawHighlight>
        <drawHighlightOnlyForHostile>true</drawHighlightOnlyForHostile>
        <soundImpactDefault>Pawn_Cavegunk_Hit</soundImpactDefault>
        <receivesSignals>true</receivesSignals>
        <altitudeLayer>Pawn</altitudeLayer>
        <stealable>false</stealable>
        <rotatable>false</rotatable>
        <passability>Impassable</passability>
        <killedLeavingsChance>0.3</killedLeavingsChance>
        <killedLeavingsRanges>
            <DV_GutterlatchPearls>2~4</DV_GutterlatchPearls>
        </killedLeavingsRanges>
        <statBases>
            <MaxHitPoints>300</MaxHitPoints>
            <Flammability>1</Flammability>
            <Mass>10</Mass>
            <ShootingAccuracyTurret>0.94</ShootingAccuracyTurret>
            <Beauty>-20</Beauty>
        </statBases>
        <damageMultipliers>
            <li>
                <damageDef>Flame</damageDef>
                <multiplier>2</multiplier>
            </li>
        </damageMultipliers>
        <tickerType>Normal</tickerType>
        <comps>
            <li Class="CompProperties_WakeUpDormant" />
            <li Class="CompProperties_SelfhealHitpoints">
                <ticksPerHeal>6000</ticksPerHeal>                <!-- 60k ticks = 1 day, 10 hp per day -->
            </li>
            <li Class="CompProperties_Spawner">
                <thingToSpawn>DV_Monster_Gutterlatchling</thingToSpawn>
                <spawnCount>1</spawnCount>
                <spawnMaxAdjacent>3</spawnMaxAdjacent>
                <spawnIntervalRange>
                    <min>14000</min>
                    <max>18000</max>
                </spawnIntervalRange>
                <writeTimeLeftToSpawn>true</writeTimeLeftToSpawn>
                <showMessageIfOwned>true</showMessageIfOwned>
            </li>
            <li Class="CompProperties_HeatPusher">
                <heatPerSecond>6</heatPerSecond>
                <heatPushMaxTemperature>38</heatPushMaxTemperature>
            </li>
            <li Class="CompProperties_SpawnerFilth">
                <filthDef>Filth_Slime</filthDef>
                <spawnCountOnSpawn>10</spawnCountOnSpawn>
                <spawnMtbHours>4</spawnMtbHours>
                <spawnRadius>3</spawnRadius>
            </li>
            <li Class="CompProperties_Stunnable">
                <affectedDamageDefs>
                    <li>Stun</li>
                </affectedDamageDefs>
            </li>
            <li Class="CompProperties_SpawnEffecterOnDestroy">
                <effect>DV_GutterlatchDestroyedLarge</effect>
            </li>
            <li Class="CompProperties_DrawAdditionalGraphics">
                <graphics>
                    <li>
                        <graphicClass>Graphic_Single</graphicClass>
                        <texPath>Things/Pawn/Animal/Gutterlatch/Gutterlatch_Under</texPath>
                        <drawSize>(1.5,1.5)</drawSize>
                        <drawOffset>(0, 0.6, 0)</drawOffset>
                        <shaderType>Transparent</shaderType>
                        <onGroundRandomRotateAngle>360</onGroundRandomRotateAngle>
                    </li>
                </graphics>
            </li>
        </comps>
        <passability>PassThroughOnly</passability>
        <pathCost>50</pathCost>
        <fillPercent>0.4</fillPercent>
        <hasTooltip>true</hasTooltip>
        <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
        <building>
            <playTargetAcquiredSound>false</playTargetAcquiredSound>
            <combatPower>45</combatPower>            <!-- same as a scavenger -->
            <ai_combatDangerous>true</ai_combatDangerous>
            <turretGunDef>DV_Gun_Gutterlatch</turretGunDef>
            <turretBurstCooldownTime>2.4</turretBurstCooldownTime>
        </building>
    </ThingDef>

    <ThingDef ParentName="BaseWeaponTurret">
        <defName>DV_Gun_Gutterlatch</defName>
        <label>gutterlatch shell</label>
        <recoilPower>5</recoilPower>
        <description>An automatic turret-mounted slug-thrower.</description>
        <graphicData>
            <texPath>Things/Pawn/Animal/Gutterlatch/Gutterlatch_Top</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>0.1</drawSize>
        </graphicData>
        <altitudeLayer>Pawn</altitudeLayer>
        <uiIconScale>1</uiIconScale>
        <statBases>
            <AccuracyTouch>0.80</AccuracyTouch>
            <AccuracyShort>0.55</AccuracyShort>
            <AccuracyMedium>0.35</AccuracyMedium>
            <AccuracyLong>0.1</AccuracyLong>
            <RangedWeapon_Cooldown>6</RangedWeapon_Cooldown>
            <DeteriorationRate>0</DeteriorationRate>
            <Mass>5</Mass>
            <Flammability>0</Flammability>
        </statBases>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <defaultProjectile>DV_Bullet_GutterlatchSpit</defaultProjectile>
                <range>30.9</range>
                <soundCast>Gutterlatch_Spit</soundCast>
                <muzzleFlashScale>0</muzzleFlashScale>
                <burstShotCount>1</burstShotCount>
            </li>
        </verbs>
    </ThingDef>

    <ThingDef ParentName="BaseBullet">
        <defName>DV_Bullet_GutterlatchSpit</defName>
        <label>gutterlatch spit</label>
        <graphicData>
            <texPath>Things/Pawn/Animal/Gutterlatch/GutterlatchSpit</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <projectile>
            <damageDef>BulletToxic</damageDef>
            <damageAmountBase>9</damageAmountBase>
            <speed>30</speed>
            <stoppingPower>1</stoppingPower>
            <shadowSize>0</shadowSize>
            <filth>Filth_SpentAcid</filth>
            <filthCount>1</filthCount>
        </projectile>
        <comps>
            <li Class="CompProperties_ProjectileEffecter">
                <effecterDef>DV_GutterlatchSpitStream</effecterDef>
            </li>
        </comps>
    </ThingDef>

    <ThingDef ParentName="BuildingBase">
        <defName>DV_Monster_Gutterlatchling</defName>
        <label>gutterlatchling</label>
        <description>The larval stage of a gutterlatch, incapable of defending itself properly.</description>
        <size>(1, 1)</size>
        <graphicData>
            <graphicClass>LTS_StonebornSiteGeneration.Graphic_Single_Growing</graphicClass>
            <texPath>Things/Pawn/Animal/Gutterlatch/Gutterlatchling</texPath>
            <drawSize>1.2</drawSize>
            <onGroundRandomRotateAngle>360</onGroundRandomRotateAngle>
        </graphicData>
        <costList>
            <DV_Meat_Gutterlatch>40</DV_Meat_Gutterlatch>
        </costList>
        <drawHighlight>true</drawHighlight>
        <drawHighlightOnlyForHostile>true</drawHighlightOnlyForHostile>
        <soundImpactDefault>Pawn_Cavegunk_Hit</soundImpactDefault>
        <fillPercent>0.40</fillPercent>
        <rotatable>false</rotatable>
        <statBases>
            <MaxHitPoints>250</MaxHitPoints>
            <WorkToBuild>1000</WorkToBuild>
        </statBases>
        <interactionCellOffset>(0,0,0)</interactionCellOffset>
        <tickerType>Normal</tickerType>
        <building>
            <claimable>false</claimable>
            <canBuildNonEdificesUnder>false</canBuildNonEdificesUnder>
            <deconstructible>false</deconstructible>
            <quickTargetable>true</quickTargetable>
        </building>
        <comps>
            <li Class="CompProperties_SelfhealHitpoints">
                <ticksPerHeal>6000</ticksPerHeal>                <!-- 60k ticks = 1 day-->
            </li>
            <li Class="LTS_StonebornSiteGeneration.CompProperties_GrowIntoThing">
                <thing>DV_Monster_Gutterlatch</thing>
                <ticksToGrow>60000</ticksToGrow>
                <finalDrawSize>1.8</finalDrawSize>
                <updateGraphicTicksInterval>10000</updateGraphicTicksInterval>
            </li>
            <li Class="CompProperties_SpawnEffecterOnDestroy">
                <effect>DV_GutterlatchDestroyedSmall</effect>
            </li>
            <li Class="CompProperties_DrawAdditionalGraphics">
                <graphics>
                    <li>
                        <graphicClass>Graphic_Single</graphicClass>
                        <texPath>Things/Pawn/Animal/Gutterlatch/Gutterlatchling_Under</texPath>
                        <drawSize>(2,2)</drawSize>
                        <drawOffset>(0, 0.6, 0)</drawOffset>
                        <shaderType>Transparent</shaderType>
                        <onGroundRandomRotateAngle>360</onGroundRandomRotateAngle>
                    </li>
                </graphics>
            </li>
        </comps>
    </ThingDef>
</Defs> 