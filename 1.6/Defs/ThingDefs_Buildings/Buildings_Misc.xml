  <ThingDef ParentName="BuildingBase">
    <defName>DV_MonsterBox</defName>
    <label>monster box</label>
    <description>A self-powered hermetically-sealed crate for preserving valuable items. These can preserve their contents for a long time.</description>
    <size>(1, 1)</size>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/MonsterBox</texPath>
    </graphicData>
    <fillPercent>0.40</fillPercent>
    <rotatable>false</rotatable>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToBuild>1000</WorkToBuild>
    </statBases>
    <interactionCellOffset>(0,0,0)</interactionCellOffset>
    <receivesSignals>true</receivesSignals>
    <comps>
      <li Class="LTS_StonebornSiteGeneration.CompProperties_MonsterBox">
        <territorialFactionDef>DV_DungeonMonsters</territorialFactionDef>
        <attackingFactionDef>AncientsHostile</attackingFactionDef>
        <territoryRadius>6</territoryRadius>
        <encounters>

          <li>            <!-- 3-4 cavegunks with alrauns -->
            <spawnWeight>1</spawnWeight>
			<spawnGroups>
			<li>
              <pawnKind>DV_Monster_CaveGunk</pawnKind>
              <range>3~4</range>
              <faction>DV_DungeonMonsters</faction>
            </li>
            <li>
              <thingDef>DV_Plant_Alraun</thingDef>
              <range>2~3</range>
              <initialPlantGrowth>1</initialPlantGrowth>
            </li>
            <li>
              <thingDef>DV_Plant_Alraun</thingDef>
              <range>3~4</range>
              <initialPlantGrowth>0.3</initialPlantGrowth>
            </li>
			</spawnGroups>
          </li>

          <li>            <!-- 3-4 cavegunks defending an area -->
            <spawnWeight>1</spawnWeight>
			<spawnGroups>
			<li>
              <pawnKind>DV_Monster_CaveGunk</pawnKind>
              <range>3~4</range>
              <faction>DV_DungeonMonsters</faction>
            </li>
			</spawnGroups>
          </li>

          <li>            <!-- 2-3 cavegunks and 1-2 rook-caps defending an area -->
            <spawnWeight>1</spawnWeight>
			<spawnGroups>
			<li>
              <pawnKind>DV_Monster_CaveGunk</pawnKind>
              <range>2~3</range>
              <faction>DV_DungeonMonsters</faction>
            </li>

            <li>
              <pawnKind>DV_Monster_ToxShroom</pawnKind>
              <range>1~2</range>
              <faction>DV_DungeonMonsters</faction>
            </li>
            <li>
              <thingDef>DV_Plant_Rookpod</thingDef>
              <range>3~4</range>
              <initialPlantGrowth>0.9</initialPlantGrowth>
            </li>
            <li>
              <thingDef>DV_Plant_Rookpod</thingDef>
              <range>4~5</range>
              <initialPlantGrowth>0.3</initialPlantGrowth>
            </li>
			</spawnGroups>
          </li>

          <li>            <!-- 2-4 rook-caps defending an area -->
            <spawnWeight>1</spawnWeight>
			<spawnGroups>
			<li>
              <pawnKind>DV_Monster_ToxShroom</pawnKind>
              <range>2~4</range>
              <faction>DV_DungeonMonsters</faction>
            </li>
            <li>
              <thingDef>DV_Plant_Rookpod</thingDef>
              <range>4~5</range>
              <initialPlantGrowth>0.9</initialPlantGrowth>
            </li>
            <li>
              <thingDef>DV_Plant_Rookpod</thingDef>
              <range>4~5</range>
              <initialPlantGrowth>0.3</initialPlantGrowth>
            </li>
			</spawnGroups>
          </li>

          <li>            <!-- 3-4 gutterlatches defending an area -->
            <spawnWeight>1</spawnWeight>
			<spawnGroups>
			<li>
              <thingDef>DV_Monster_Gutterlatch</thingDef>
              <range>3~4</range>
              <faction>DV_DungeonMonsters</faction>
            </li>
            <li>
              <thingDef>DV_Monster_Gutterlatchling</thingDef>
              <range>4~5</range>
              <faction>DV_DungeonMonsters</faction>
            </li>
			</spawnGroups>
          </li>

          <li>            <!-- 2-3 imps defending an area -->
            <spawnWeight>1</spawnWeight>
			<spawnGroups>
			<li>
              <pawnKind>DV_Monster_Imp</pawnKind>
              <range>2~3</range>
              <faction>DV_DungeonMonsters</faction>
            </li>
			</spawnGroups>
          </li>

          <li>            <!-- 1 ogre defending an area -->
            <spawnWeight>1</spawnWeight>
			<spawnGroups>
			<li>
              <pawnKind>DV_Monster_Tusktroll</pawnKind>
              <range>1</range>
              <faction>DV_DungeonMonsters</faction>
            </li>
			</spawnGroups>
          </li>

          <li>            <!-- 1 ogre defending an area, with some alrauns -->
            <spawnWeight>1</spawnWeight>
			<spawnGroups>
			<li>
              <pawnKind>DV_Monster_Tusktroll</pawnKind>
              <range>1</range>
              <faction>DV_DungeonMonsters</faction>
            </li>

            <li>
              <thingDef>DV_Plant_Alraun</thingDef>
              <range>2~3</range>
              <initialPlantGrowth>1</initialPlantGrowth>
            </li>
            <li>
              <thingDef>DV_Plant_Alraun</thingDef>
              <range>3~4</range>
              <initialPlantGrowth>0.3</initialPlantGrowth>
            </li>
			</spawnGroups>
          </li>

          <li>            <!-- 2 ogres defending an area -->
            <spawnWeight>1</spawnWeight>
			<spawnGroups>
			<li>
              <pawnKind>DV_Monster_Tusktroll</pawnKind>
              <range>2</range>
              <faction>DV_DungeonMonsters</faction>
            </li>
			</spawnGroups>
          </li>

          <li>            <!-- 5-6 razorbeaks defending an area -->
            <spawnWeight>1</spawnWeight>
			<spawnGroups>
			<li>
              <pawnKind>DV_Monster_Razorbeak</pawnKind>
              <range>5~6</range>
              <faction>DV_DungeonMonsters</faction>
            </li>
			</spawnGroups>
          </li>

          <li>            <!--3 rook-caps and 3 razorbeaks feuding -->
            <spawnWeight>1</spawnWeight>
			<spawnGroups>
			<li>
              <pawnKind>DV_Monster_ToxShroom</pawnKind>
              <range>3</range>
              <faction>DV_DungeonMonsters</faction>
            </li>
            <li>
              <thingDef>DV_Plant_Rookpod</thingDef>
              <range>4~5</range>
              <initialPlantGrowth>0.9</initialPlantGrowth>
            </li>

            <li>
              <pawnKind>DV_Monster_Razorbeak</pawnKind>
              <range>3</range>
              <faction>AncientsHostile</faction>
            </li>
			</spawnGroups>
          </li>

          <li>            <!--2 ogres feuding -->
            <spawnWeight>1</spawnWeight>
			<spawnGroups>
			<li>
              <pawnKind>DV_Monster_Tusktroll</pawnKind>
              <range>1</range>
              <faction>DV_DungeonMonsters</faction>
            </li>
            <li>
              <pawnKind>DV_Monster_Tusktroll</pawnKind>
              <range>1</range>
              <faction>AncientsHostile</faction>
            </li>
			</spawnGroups>
          </li>

        </encounters>
      </li>

    </comps>
    <tickerType>Normal</tickerType>
  </ThingDef>

