<?xml version="1.0" encoding="UTF-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>DV_PlantBox</defName>
    <label>plant box</label>
    <description>A self-powered hermetically-sealed crate for preserving valuable items. These can preserve their contents for a long time.</description>
    <size>(1, 1)</size>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/PlantBox</texPath>
    </graphicData>
    <fillPercent>0.40</fillPercent>
    <rotatable>false</rotatable>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToBuild>1000</WorkToBuild>
    </statBases>
    <interactionCellOffset>(0,0,0)</interactionCellOffset>
    <receivesSignals>true</receivesSignals>
    <comps>
      <li Class="LTS_StonebornSiteGeneration.CompProperties_MonsterBox">
        <territoryRadius>8</territoryRadius>
        <encounters>

          <li>            <!-- sagewick -->
            <spawnWeight>1</spawnWeight>
			<spawnGroups>
			<li>
              <thingDef>DV_Plant_Cinderwort</thingDef>
              <range>3~4</range>
              <initialPlantGrowth>1</initialPlantGrowth>
            </li>
            <li>
              <thingDef>DV_Plant_Cinderwort</thingDef>
              <range>4~5</range>
              <initialPlantGrowth>0.3</initialPlantGrowth>
            </li>
			</spawnGroups>
          </li>


          <li>            <!-- sagewick and alraun -->
		    <spawnWeight>1</spawnWeight>
			<spawnGroups>
            <li>
              <thingDef>DV_Plant_Alraun</thingDef>
              <range>2~3</range>
              <initialPlantGrowth>1</initialPlantGrowth>
            </li>
            <li>
              <thingDef>DV_Plant_Alraun</thingDef>
              <range>3~5</range>
              <initialPlantGrowth>0.3</initialPlantGrowth>
            </li>

            <li>
              <thingDef>DV_Plant_Cinderwort</thingDef>
              <range>1~2</range>
              <initialPlantGrowth>1</initialPlantGrowth>
            </li>
            <li>
              <thingDef>DV_Plant_Cinderwort</thingDef>
              <range>2~4</range>
              <initialPlantGrowth>0.3</initialPlantGrowth>
            </li>
			</spawnGroups>
          </li>

          <li>            <!-- sagewick and cavecarrots -->
            <spawnWeight>1</spawnWeight>
			<spawnGroups>
			<li>
              <thingDef>DV_Plant_Cavecarrot</thingDef>
              <range>2~3</range>
              <initialPlantGrowth>1</initialPlantGrowth>
            </li>
            <li>
              <thingDef>DV_Plant_Cavecarrot</thingDef>
              <range>3~5</range>
              <initialPlantGrowth>0.3</initialPlantGrowth>
            </li>

            <li>
              <thingDef>DV_Plant_Cinderwort</thingDef>
              <range>1~2</range>
              <initialPlantGrowth>1</initialPlantGrowth>
            </li>
            <li>
              <thingDef>DV_Plant_Cinderwort</thingDef>
              <range>2~4</range>
              <initialPlantGrowth>0.3</initialPlantGrowth>
            </li>
			</spawnGroups>
          </li>

          <li>            <!-- alrauns -->
            <spawnWeight>1</spawnWeight>
			<spawnGroups>
			<li>
              <thingDef>DV_Plant_Alraun</thingDef>
              <range>4~5</range>
              <initialPlantGrowth>1</initialPlantGrowth>
            </li>
            <li>
              <thingDef>DV_Plant_Alraun</thingDef>
              <range>5~6</range>
              <initialPlantGrowth>0.3</initialPlantGrowth>
            </li>
			</spawnGroups>
          </li>

          <li>            <!-- cavecarrots -->
            <spawnWeight>1</spawnWeight>
			<spawnGroups>
			<li>
              <thingDef>DV_Plant_Cavecarrot</thingDef>
              <range>4~5</range>
              <initialPlantGrowth>1</initialPlantGrowth>
            </li>
            <li>
              <thingDef>DV_Plant_Cavecarrot</thingDef>
              <range>5~6</range>
              <initialPlantGrowth>0.3</initialPlantGrowth>
            </li>
			</spawnGroups>
          </li>

          <li>            <!-- cavecarrots and alraun -->
            <spawnWeight>1</spawnWeight>
			<spawnGroups>
			<li>
              <thingDef>DV_Plant_Cavecarrot</thingDef>
              <range>2~3</range>
              <initialPlantGrowth>1</initialPlantGrowth>
            </li>
            <li>
              <thingDef>DV_Plant_Cavecarrot</thingDef>
              <range>3~5</range>
              <initialPlantGrowth>0.3</initialPlantGrowth>
            </li>

            <li>
              <thingDef>DV_Plant_Alraun</thingDef>
              <range>2~3</range>
              <initialPlantGrowth>1</initialPlantGrowth>
            </li>
            <li>
              <thingDef>DV_Plant_Alraun</thingDef>
              <range>3~5</range>
              <initialPlantGrowth>0.3</initialPlantGrowth>
            </li>
			</spawnGroups>
          </li>
        </encounters>
      </li>

    </comps>
    <tickerType>Normal</tickerType>
  </ThingDef>

