<?xml version="1.0" encoding="UTF-8"?>
<Defs>

  <ThingDef Name="LTS_StonebornVaultEntranceClosedBase" ParentName="BuildingBase" Abstract="True">
    <label>vault entrance</label>
    <description>The entrance to a long-abandoned stoneborn vault. Hack it to open the hatch.</description>
    <size>(3,3)</size>
    <useHitPoints>false</useHitPoints>
    <rotatable>false</rotatable>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <canOverlapZones>false</canOverlapZones>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/Ruins/Dwarven_VaultDoor/Dwarven_EntranceHatch_Closed</texPath>
      <drawSize>(3, 3)</drawSize>
    </graphicData>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <fillPercent>0</fillPercent>
    <passability>Impassable</passability>
    <holdsRoof>true</holdsRoof>
    <destroyable>true</destroyable>    <!--for switching types during genstep-->
    <building>
      <isEdifice>true</isEdifice>
      <deconstructible>false</deconstructible>
      <isTargetable>false</isTargetable>
      <isInert>true</isInert>
      <claimable>false</claimable>
      <expandHomeArea>false</expandHomeArea>
    </building>
    <statBases>
      <Flammability>0</Flammability>
    </statBases>
  </ThingDef>

  <ThingDef Name="LTS_StonebornVaultEntranceOpenBase" ParentName="BuildingBase" Abstract="True">
    <thingClass>LTS_StonebornSiteGeneration.LTS_VaultHatch</thingClass>
    <label>vault entrance</label>
    <description>The entrance to a long-abandoned stoneborn vault. Hack it to open the hatch.</description>
    <size>(3,3)</size>
    <useHitPoints>false</useHitPoints>
    <rotatable>false</rotatable>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <canOverlapZones>false</canOverlapZones>
    <tickerType>Normal</tickerType>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/Ruins/Dwarven_VaultDoor/Dwarven_EntranceHatch_Open</texPath>
      <drawSize>(3, 3)</drawSize>
    </graphicData>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <fillPercent>0</fillPercent>
    <passability>Impassable</passability>
    <holdsRoof>true</holdsRoof>
    <destroyable>false</destroyable>
    <building>
      <isEdifice>true</isEdifice>
      <deconstructible>false</deconstructible>
      <isTargetable>false</isTargetable>
      <isInert>true</isInert>
      <claimable>false</claimable>
      <expandHomeArea>false</expandHomeArea>
    </building>
    <statBases>
      <Flammability>0</Flammability>
    </statBases>
    <inspectorTabs>
      <li>ITab_ContentsMapPortal</li>
    </inspectorTabs>
  </ThingDef>

  <ThingDef Name="LTS_StonebornVaultExitBase" ParentName="PocketMapExit" Abstract="True">
    <label>vault exit</label>
    <description>A ladder which links to the surface hatch above.</description>
    <size>(3,3)</size>
    <drawerType>RealtimeOnly</drawerType>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/Ruins/Dwarven_VaultDoor/Dwarven_EntranceHatch_ExitBottom</texPath>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <destroyable>true</destroyable>    <!--for switching types during genstep-->
  </ThingDef>

  <ThingDef ParentName="LTS_StonebornVaultEntranceClosedBase">
    <defName>LTS_StonebornVaultEntrance</defName>
    <comps>
      <li Class="VEF.Buildings.CompProperties_JammedAirlock">
        <doorToConvertTo>LTS_StonebornVaultEntranceOpen</doorToConvertTo>
        <activeTicks>1</activeTicks>
        <ticksToActivate>1800</ticksToActivate>
        <activateTexPath>UI/ForceHatchOpen</activateTexPath>
        <activateLabelString>Force open...</activateLabelString>
        <activateDescString>Choose someone to force this vault hatch open.</activateDescString>
        <guiLabelString>Choose who should do this</guiLabelString>
        <jobString>Force this vault hatch open</jobString>
        <activatingStringPending>forcing vault hatch open</activatingStringPending>
        <activatingString>forcing vault hatch open: {1}s</activatingString>
        <messageCompletedString>{PAWN_nameDef} has successfully forced the vault hatch open.</messageCompletedString>
        <targetingParameters>
          <canTargetBuildings>false</canTargetBuildings>
          <canTargetAnimals>false</canTargetAnimals>
          <canTargetMechs>false</canTargetMechs>
          <onlyTargetControlledPawns>true</onlyTargetControlledPawns>
        </targetingParameters>
        <stringExtra>DV_HatchLocked</stringExtra>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="LTS_StonebornVaultEntranceOpenBase">
    <defName>LTS_StonebornVaultEntranceOpen</defName>
    <portal>
      <pocketMapGenerator>LTS_StonebornVault</pocketMapGenerator>
      <exitDef>LTS_StonebornVaultExit</exitDef>
      <pocketMapSize>75</pocketMapSize>
    </portal>
    <modExtensions>
      <li Class="LTS_StonebornSiteGeneration.LTS_SFE_ModExtension">
        <LTS_GenStepDef>LTS_StonebornVault</LTS_GenStepDef>
        <LTS_TexPath>Things/Building/Ruins/Dwarven_VaultDoor/Dwarven_EntranceHatch_Open</LTS_TexPath>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="LTS_StonebornVaultEntranceClosedBase">
    <defName>LTS_StonebornVaultEntranceIntermediate</defName>
    <comps>
      <li Class="VEF.Buildings.CompProperties_JammedAirlock">
        <doorToConvertTo>LTS_StonebornVaultEntranceIntermediateOpen</doorToConvertTo>
        <activeTicks>1</activeTicks>
        <ticksToActivate>1800</ticksToActivate>
        <activateTexPath>UI/ForceHatchOpen</activateTexPath>
        <activateLabelString>Force open...</activateLabelString>
        <activateDescString>Choose someone to force this vault hatch open.</activateDescString>
        <guiLabelString>Choose who should do this</guiLabelString>
        <jobString>Force this vault hatch open</jobString>
        <activatingStringPending>forcing vault hatch open</activatingStringPending>
        <activatingString>forcing vault hatch open: {1}s</activatingString>
        <messageCompletedString>{PAWN_nameDef} has successfully forced the vault hatch open.</messageCompletedString>
        <targetingParameters>
          <canTargetBuildings>false</canTargetBuildings>
          <canTargetAnimals>false</canTargetAnimals>
          <canTargetMechs>false</canTargetMechs>
          <onlyTargetControlledPawns>true</onlyTargetControlledPawns>
        </targetingParameters>
        <stringExtra>DV_HatchLocked</stringExtra>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="LTS_StonebornVaultEntranceOpenBase">
    <defName>LTS_StonebornVaultEntranceIntermediateOpen</defName>
    <portal>
      <pocketMapGenerator>LTS_StonebornVaultIntermediate</pocketMapGenerator>
      <exitDef>LTS_StonebornVaultExitIntermediate</exitDef>
      <pocketMapSize>75</pocketMapSize>
    </portal>
    <modExtensions>
      <li Class="LTS_StonebornSiteGeneration.LTS_SFE_ModExtension">
        <LTS_GenStepDef>LTS_StonebornVaultIntermediate</LTS_GenStepDef>
        <LTS_TexPath>Things/Building/Ruins/Dwarven_VaultDoor/Dwarven_EntranceHatch_Open</LTS_TexPath>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="LTS_StonebornVaultEntranceOpenBase">
    <defName>LTS_StonebornVaultEntranceOuter</defName>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/Ruins/Dwarven_VaultDoor/Dwarven_VaultDoor_Closed</texPath>
      <drawSize>(3, 3)</drawSize>
    </graphicData>
    <portal>
      <pocketMapGenerator>LTS_StonebornVaultFirstFloor</pocketMapGenerator>
      <exitDef>LTS_StonebornVaultExitOuter</exitDef>
      <pocketMapSize>75</pocketMapSize>
    </portal>
    <comps>
      <li Class="CompProperties_Hackable">
        <defence>39000</defence>
        <effectHacking>HackingTerminal</effectHacking>
        <lockoutDurationHoursRange>6~18</lockoutDurationHoursRange>
        <showProgressAfterHackCompletion>false</showProgressAfterHackCompletion>
        <notHackedInspectString>Hack to open.</notHackedInspectString>
        <intellectualSkillPrerequisite>6</intellectualSkillPrerequisite>
        <hackingCompletedSound>AncientHatchOpened</hackingCompletedSound>
        <hackedMessage>{HACKER_labelShort} has finished hacking {SUBJECT_labelNoParenthesisDef}.</hackedMessage>
      </li>
    </comps>
    <modExtensions>
      <li Class="LTS_StonebornSiteGeneration.LTS_SFE_ModExtension">
        <LTS_GenStepDef>LTS_StonebornVaultIntermediate</LTS_GenStepDef>
        <LTS_TexPath>Things/Building/Ruins/Dwarven_VaultDoor/Dwarven_VaultDoor_Open</LTS_TexPath>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="LTS_StonebornVaultExitBase">
    <defName>LTS_StonebornVaultExit</defName>
    <portal>
      <exitDef>LTS_StonebornVaultEntranceOpen</exitDef>
    </portal>
    <comps>
      <li Class="CompProperties_DrawAdditionalGraphics">
        <graphics>
          <li>
            <graphicClass>Graphic_Single</graphicClass>
            <texPath>Things/Building/Ruins/Dwarven_VaultDoor/Dwarven_EntranceHatch_ExitStairs</texPath>
            <drawSize>(3,3)</drawSize>
            <drawOffset>(0, 0.01, 0.7)</drawOffset>
            <shaderType>Transparent</shaderType>
          </li>
        </graphics>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="LTS_StonebornVaultExitBase">
    <defName>LTS_StonebornVaultExitIntermediate</defName>
    <portal>
      <exitDef>LTS_StonebornVaultEntranceIntermediateOpen</exitDef>
    </portal>
    <comps>
      <li Class="CompProperties_DrawAdditionalGraphics">
        <graphics>
          <li>
            <graphicClass>Graphic_Single</graphicClass>
            <texPath>Things/Building/Ruins/Dwarven_VaultDoor/Dwarven_EntranceHatch_ExitStairs</texPath>
            <drawSize>(3,3)</drawSize>
            <drawOffset>(0, 0.01, 0.7)</drawOffset>
            <shaderType>Transparent</shaderType>
          </li>
        </graphics>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="LTS_StonebornVaultExitBase">
    <defName>LTS_StonebornVaultExitOuter</defName>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/Ruins/Dwarven_VaultDoor/Dwarven_VaultDoor_ExitBottom</texPath>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <portal>
      <exitDef>LTS_StonebornVaultEntranceOuter</exitDef>
    </portal>
    <comps>
      <li Class="CompProperties_DrawAdditionalGraphics">
        <graphics>
          <li>
            <graphicClass>Graphic_Single</graphicClass>
            <texPath>Things/Building/Ruins/Dwarven_VaultDoor/Dwarven_VaultDoor_ExitStairs</texPath>
            <drawSize>(3,3)</drawSize>
            <drawOffset>(0, 0.01, 0.7)</drawOffset>
